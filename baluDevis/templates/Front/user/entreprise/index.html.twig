
{% extends 'base.html.twig' %}

{% block title %}Entreprises{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
	<div class="flex flex-col gap-7">
		<div class="w-full flex items-center justify-between">
			<h1 class="text-4xl text-secondary-500 font-extrabold">Entreprises</h1>
		</div>

        <div class="relative overflow-x-auto rounded-3xl border  border-primaryLight shadow-sm">
            <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
                <thead class="text-xs text-gray-700 uppercase bg-white border-b">
                    <tr>
                        <th scope="col" class="px-6 py-3 font-bold">Nom entreprrise</th>
                        <th scope="col" class="px-6 py-3 font-bold">email</th>
                        <th scope="col" class="px-6 py-3 font-bold">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for entreprise in entreprises %}
                    <tr class="product-row bg-white border-b transition-opacity duration-300 ease-in-out">
                        <th scope="row" class="px-6 py-4 font-medium text-secondary-900 whitespace-nowrap">{{entreprise.nomEntreprise }}</th>
                        <td class="px-6 py-4 text-secondary-300">{{ entreprise.email }}</td>
                        <td class="px-6 py-4 text-secondary-300 flex items-center gap-2">
                        <div class="inline-flex rounded-md shadow-sm items-center w-full h-full">
                            <a href="{{ path('front_user_entreprise_show', {'id': entreprise.id}) }}" aria-current="page" class="px-4 py-2 text-sm font-medium text-primary-700 bg-white border border-gray-200 rounded-s-lg hover:bg-gray-100 focus:z-10 focus:ring-2 ">
                                Détails
                            </a>
                            <a href="{{ path('front_user_entreprise_edit', {'id': entreprise.id}) }}" class="px-4 py-2 text-sm font-medium text-white bg-secondary border-t border-b border-gray-200 hover:opacity-90 focus:z-10 focus:ring-2">
                                Editer
                            </a>
                             {{ include('Front/user/entreprise/_delete_form.html.twig') }}
                        </div>
                        </td>
                    </tr>
                {% else %}
                    <tr class="bg-white border-b">
                        <td colspan="5">Pas d'entreprise.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %} 
