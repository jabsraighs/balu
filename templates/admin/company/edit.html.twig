{% extends 'base.html.twig' %}

{% block title %}Modifier l'entreprise{% endblock %}

{% block page_content %}
	<div class="min-h-screen flex bg-gray-50 dark:bg-gray-900">
		{# Right side - Company edit form #}
		<div class="w-full flex items-center justify-center p-16">
			<div class="w-full max-w-md">
				<div class="text-center mb-8">
					<h2 class="text-3xl font-bold text-baluBlue mb-2">Modifier l'entreprise</h2>
				</div>

				{{ form_errors(form) }}

				{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
				<div class="space-y-2">
					<label for="{{ form.name.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Nom de l'entreprise
                        
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
							</svg>
						</div>
						{{ form_widget(form.name, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': 'Nom de l\'entreprise'
                            }
                        }) }}
					</div>
					{{ form_errors(form.name) }}
				</div>

				<div class="space-y-2">
					<label for="{{ form.siret.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						SIRET
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
							</svg>
						</div>
						{{ form_widget(form.siret, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': '12345678901234',
                                'pattern': '[0-9]{14}',
                                'maxlength': '14'
                            }
                        }) }}
					</div>
					{{ form_errors(form.siret) }}
				</div>

				<div class="space-y-2">
					<label for="{{ form.address.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Adresse
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
							</svg>
						</div>
						{{ form_widget(form.address, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': '123 Rue de l\'exemple, 75000 Paris'
                            }
                        }) }}
					</div>
					{{ form_errors(form.address) }}
				</div>

				<div class="flex items-center justify-between mt-8">
					<a href="{{ path('app_admin_company_index') }}" class="text-sm font-medium text-baluBlue hover:text-baluBlue-light">
						Retour à la liste
					</a>
					<div class="flex space-x-2">
						<button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-baluBlue hover:bg-baluBlue-light focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue">
							Enregistrer
						</button>
						<a href="{{ path('app_admin_company_delete', {'id': company.id}) }}" 
						   onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette entreprise ?')"
						   class="inline-flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
							Supprimer
						</a>
					</div>
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}