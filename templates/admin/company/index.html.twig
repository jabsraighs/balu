{% extends 'base.html.twig' %}

{% block title %}Entreprises{% endblock %}

{% block page_content %}
<div class="container mx-auto px-4 py-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Entreprises</h1>
    </div>
    
    <div class="flex justify-between items-center mb-6">
        <div>
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Toutes les entreprises</h2>
            <p class="text-gray-500 dark:text-gray-400">Gérez les entreprises de la plateforme</p>
        </div>
        <a href="{{ path('admin_company_new') }}" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-baluBlue hover:bg-baluBlue-light rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue">
            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="M12 5v14"></path>
            </svg>
            Ajouter une entreprise
        </a>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden">
        <div class="relative w-full overflow-auto">
            <table class="w-full caption-bottom text-sm">
                <thead>
                    <tr class="border-b transition-colors hover:bg-muted/50">
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Nom</th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">SIRET</th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Adresse</th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Nombre d'utilisateurs</th>
                        <th class="h-12 px-4 text-right align-middle font-medium text-muted-foreground">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for company in companies %}
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            <td class="p-4 align-middle">{{ company.name }}</td>
                            <td class="p-4 align-middle">{{ company.siret ?: '-' }}</td>
                            <td class="p-4 align-middle">{{ company.address ?: '-' }}</td>
                            <td class="p-4 align-middle">{{ company.users|length }}</td>
                            <td class="p-4 align-middle text-right">
                                <div class="flex justify-end space-x-2">
                                    <a href="{{ path('admin_company_show', {'id': company.id}) }}" class="inline-flex items-center justify-center px-3 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-700">
                                        Voir
                                    </a>
                                    <a href="{{ path('admin_company_edit', {'id': company.id}) }}" class="inline-flex items-center justify-center px-3 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-700">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                                            <path d="m15 5 4 4"></path>
                                        </svg>
                                        Modifier
                                    </a>
                                    <button type="button" class="inline-flex items-center justify-center px-3 py-1 text-xs font-medium text-red-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 dark:bg-gray-800 dark:border-gray-700 dark:text-red-400 dark:hover:bg-gray-700" data-company-id="{{ company.id }}" data-company-name="{{ company.name }}">
                                        Supprimer
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="p-4 align-middle text-center text-gray-500 dark:text-gray-400">Aucune entreprise trouvée</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de suppression -->
<div id="deleteConfirmModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden">
    <div class="bg-white dark:bg-gray-800 rounded-lg max-w-md w-full mx-auto">
        <div class="p-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
            <h5 class="text-lg font-semibold text-gray-900 dark:text-white">Supprimer l'entreprise</h5>
            <button type="button" class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300" id="closeModal">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="p-4 border-b border-gray-200 dark:border-gray-700">
            <p id="deleteConfirmMessage" class="text-gray-700 dark:text-gray-300">Êtes-vous sûr de vouloir supprimer cette entreprise ? Cette action ne peut pas être annulée.</p>
        </div>
        <div class="p-4 flex justify-end gap-2">
            <button type="button" id="cancelDelete" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-600">
                Annuler
            </button>
            <form id="deleteCompanyForm" method="POST" action="">
                <input type="hidden" name="_token" id="csrf_token_placeholder" value="">
                <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-700 focus:outline-none dark:bg-red-700 dark:hover:bg-red-800">
                    Supprimer
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    window.csrfTokens = {
        {% for company in companies %}
            "{{ company.id }}": "{{ csrf_token('delete' ~ company.id) }}",
        {% endfor %}
    };

    function openDeleteModal(companyId, companyName) {
        const modal = document.getElementById('deleteConfirmModal');
        const deleteForm = document.getElementById('deleteCompanyForm');
        const csrfTokenInput = document.getElementById('csrf_token_placeholder');
        const confirmMessage = document.getElementById('deleteConfirmMessage');

        deleteForm.action = "{{ path('admin_company_delete', {'id': 'COMPANY_ID'}) }}".replace('COMPANY_ID', companyId);
        csrfTokenInput.value = window.csrfTokens[companyId];
        confirmMessage.textContent = `Êtes-vous sûr de vouloir supprimer l'entreprise "${companyName}" ? Cette action ne peut pas être annulée.`;

        modal.classList.remove('hidden');
    }

    document.addEventListener('turbo:load', function() {
        initializeDeleteFunctionality();
    });

    document.addEventListener('DOMContentLoaded', function() {
        initializeDeleteFunctionality();
    });

    function initializeDeleteFunctionality() {
        const closeModal = document.getElementById('closeModal');
        if (closeModal) {
            closeModal.addEventListener('click', function() {
                document.getElementById('deleteConfirmModal').classList.add('hidden');
            });
        }

        const cancelDelete = document.getElementById('cancelDelete');
        if (cancelDelete) {
            cancelDelete.addEventListener('click', function() {
                document.getElementById('deleteConfirmModal').classList.add('hidden');
            });
        }

        const modal = document.getElementById('deleteConfirmModal');
        modal.addEventListener('click', function(event) {
            if (event.target === modal) {
                modal.classList.add('hidden');
            }
        });

        // Gérer les boutons de suppression
        const deleteButtons = document.querySelectorAll('[data-company-id]');
        deleteButtons.forEach(button => {
            button.addEventListener('click', function() {
                const companyId = this.getAttribute('data-company-id');
                const companyName = this.getAttribute('data-company-name');
                openDeleteModal(companyId, companyName);
            });
        });
    }
</script>
{% endblock %}
