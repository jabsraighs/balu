{% extends 'base.html.twig' %}

{% block title %}Nouveau Produit{% endblock %}

{% block page_content %}
<div class="container mx-auto px-4 py-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Nouveau Produit</h1>
    </div>
    
    <div class="mb-6">
        <a href="{{ path('admin_product_index') }}" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 19-7-7 7-7"></path>
                <path d="M19 12H5"></path>
            </svg>
            Retour
        </a>
    </div>
    
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden">
        <div class="p-6">
            {{ form_start(form, {
                'attr': {
                    'class': 'space-y-6',
                    'novalidate': 'novalidate'
                }
            }) }}
                
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.name, 'Nom*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.name, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white',
                            'placeholder': 'Nom du produit'
                        }
                    }) }}
                    {{ form_errors(form.name, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                
                <div>
                    {{ form_label(form.unitPrice, 'Prix unitaire*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.unitPrice, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white',
                            'placeholder': '0.00'
                        }
                    }) }}
                    {{ form_errors(form.unitPrice, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                
                <div>
                    {{ form_label(form.category, 'Catégorie*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.category, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white'
                        }
                    }) }}
                    {{ form_errors(form.category, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                
                <div>
                    {{ form_label(form.company, 'Entreprise*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.company, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white'
                        }
                    }) }}
                    {{ form_errors(form.company, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
            </div>
            
            <div>
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                {{ form_widget(form.description, {
                    'attr': {
                        'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white min-h-[100px]',
                        'placeholder': 'Description du produit'
                    }
                }) }}
                {{ form_errors(form.description, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
            </div>
            
            <div class="flex justify-end space-x-2 mt-6">
                <a 
                    href="{{ path('admin_product_index') }}" 
                    class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700"
                >
                    Annuler
                </a>
                <button 
                    type="submit" 
                    class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-baluBlue hover:bg-baluBlue-light rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue"
                >
                    Créer
                </button>
            </div>
            
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
    document.addEventListener('turbo:load', function() {
        const form = document.querySelector('form');
        form.addEventListener('submit', function(event) {
            const errorElements = document.querySelectorAll('.js-form-error');
            errorElements.forEach(element => element.remove());

            let hasErrors = false;
            
            const nameInput = document.getElementById('product_name');
            if (nameInput && nameInput.value.length < 2) {
                const errorElement = document.createElement('p');
                errorElement.classList.add('text-red-500', 'text-sm', 'mt-1', 'js-form-error');
                errorElement.textContent = 'Le nom doit contenir au moins 2 caractères.';
                nameInput.parentNode.appendChild(errorElement);
                hasErrors = true;
            }
            
            const priceInput = document.getElementById('product_unitPrice');
            if (priceInput) {
                const value = parseFloat(priceInput.value.replace(',', '.'));
                if (isNaN(value) || value <= 0) {
                    const errorElement = document.createElement('p');
                    errorElement.classList.add('text-red-500', 'text-sm', 'mt-1', 'js-form-error');
                    errorElement.textContent = 'Veuillez entrer un prix valide supérieur à 0.';
                    priceInput.parentNode.appendChild(errorElement);
                    hasErrors = true;
                }
            }
            
            const categorySelect = document.getElementById('product_category');
            if (categorySelect && categorySelect.value === "") {
                const errorElement = document.createElement('p');
                errorElement.classList.add('text-red-500', 'text-sm', 'mt-1', 'js-form-error');
                errorElement.textContent = 'Veuillez sélectionner une catégorie.';
                categorySelect.parentNode.appendChild(errorElement);
                hasErrors = true;
            }
            
            if (hasErrors) {
                event.preventDefault();
            }
        });

        var companySelect = document.querySelector('#product_company');
        var categorySelect = document.querySelector('#product_category');
        
        if (companySelect && categorySelect) {
            categorySelect.disabled = true;
            if (!companySelect.value) {
                categorySelect.innerHTML = '<option value="">Veuillez d\'abord sélectionner une entreprise</option>';
            }
            
            companySelect.addEventListener('change', function() {
                var companyId = this.value;
                categorySelect.disabled = true;
                categorySelect.innerHTML = '<option value="">Chargement des catégories...</option>';
                
                if (!companyId) {
                    categorySelect.innerHTML = '<option value="">Veuillez d\'abord sélectionner une entreprise</option>';
                    categorySelect.disabled = true;
                    return;
                }
                
                fetch('{{ path('admin_product_categories') }}?company_id=' + companyId)
                    .then(response => response.json())
                    .then(data => {
                        categorySelect.innerHTML = '<option value="">Sélectionnez une catégorie</option>';
                        
                        if (data.length === 0) {
                            categorySelect.innerHTML += '<option value="" disabled>Aucune catégorie disponible pour cette entreprise</option>';
                        } else {
                            data.forEach(function(category) {
                                var option = document.createElement('option');
                                option.value = category.id;
                                option.textContent = category.name;
                                categorySelect.appendChild(option);
                            });
                        }
                        
                        categorySelect.disabled = false;
                    })
                    .catch(error => {
                        console.error('Erreur lors du chargement des catégories:', error);
                        categorySelect.innerHTML = '<option value="">Erreur de chargement des catégories</option>';
                        categorySelect.disabled = true;
                    });
            });
            
            if (companySelect.value) {
                companySelect.dispatchEvent(new Event('change'));
            }
        }
    });
</script>
{% endblock %}
