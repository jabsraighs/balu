{% extends 'base.html.twig' %}

{% block title %}Détails du client{% endblock %}

{% block page_content %}
<div class="container mx-auto px-4 py-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Détails du Client</h1>
    </div>
    
    <div class="mb-6">
        <a href="{{ path('admin_client_index') }}" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 19-7-7 7-7"></path>
                <path d="M19 12H5"></path>
            </svg>
            Retour à la liste
        </a>
    </div>
    
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden">
        <div class="p-6">
            <div class="flex justify-between items-start mb-6">
                <div class="flex items-center">
                    <div class="flex-shrink-0 h-16 w-16 rounded-full bg-baluBlue text-white flex items-center justify-center text-2xl font-medium">
                        {{ client.name|first|upper }}
                    </div>
                    <div class="ml-4">
                        <h2 class="text-xl font-bold text-gray-900 dark:text-white">{{ client.name }}</h2>
                        <p class="text-gray-500 dark:text-gray-400">{{ client.company ? client.company.name : 'Aucune entreprise' }}</p>
                    </div>
                </div>
                
                <div class="flex space-x-2">
                    <a 
                        href="{{ path('admin_client_edit', {'id': client.id}) }}" 
                        class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                            <path d="m15 5 4 4"></path>
                        </svg>
                        Modifier
                    </a>
                    <button 
                        type="button" 
                        class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
                        onclick="openDeleteModal()"
                    >
                        Supprimer
                    </button>
                </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Informations de contact</h2>
                    <div class="space-y-3">
                        <div>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Email</p>
                            <p class="text-gray-900 dark:text-white">{{ client.email ?: 'Non renseigné' }}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Téléphone</p>
                            <p class="text-gray-900 dark:text-white">{{ client.phone ?: 'Non renseigné' }}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Adresse</p>
                            <p class="text-gray-900 dark:text-white">{{ client.address ?: 'Non renseigné' }}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Date de création</p>
                            <p class="text-gray-900 dark:text-white">{{ client.createdAt ? client.createdAt|date('d/m/Y') : 'Non renseigné' }}</p>
                        </div>
                    </div>
                </div>
                
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Activité</h2>
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-500 dark:text-gray-400">Nombre de devis</p>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-800/30 dark:text-blue-500">
                                {{ client.quotes|length }}
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <p class="text-sm text-gray-500 dark:text-gray-400">Nombre de factures</p>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-800/30 dark:text-green-500">
                                {{ client.invoices|length }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal de suppression -->
    <div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 max-w-md w-full">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Confirmer la suppression</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-6">Êtes-vous sûr de vouloir supprimer ce client ? Cette action est irréversible.</p>
            <div class="flex justify-end space-x-3">
                <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700" onclick="document.getElementById('deleteModal').classList.add('hidden')">
                    Annuler
                </button>
                
                <form method="post" action="{{ path('admin_client_delete', {'id': client.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                    <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                        Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openDeleteModal() {
        document.getElementById('deleteModal').classList.remove('hidden');
    }
</script>
{% endblock %}
