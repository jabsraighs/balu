{% extends 'base.html.twig' %}

{% block title %}
{% endblock %}

{% block page_content %}
	<div class="min-h-screen flex bg-gray-50 dark:bg-gray-900">
		

		{# Right side - Registration form #}
		<div class="w-full lg:w-1/2 flex items-center justify-center p-16">
			<div class="w-full max-w-md">
				<div class="text-center mb-8">
					
					<h2 class="text-3xl font-bold text-baluBlue mb-2">Ajouter un User</h2>
				</div>

				{% for flash_error in app.flashes('verify_email_error') %}
					<div class="mb-4 p-4 text-sm text-red-800 bg-red-100 rounded-lg" role="alert">{{ flash_error }}</div>
				{% endfor %}

				{{ form_errors(form) }}

				{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
				<div class="space-y-2">
					<label for="{{ form.fullname.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Nom complet
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
						</div>
						{{ form_widget(form.fullname, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': 'John Doe'
                            }
                        }) }}
					</div>
					{{ form_errors(form.fullname) }}
				</div>

				<div class="space-y-2">
					<label for="{{ form.company.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Nom de l'entreprise
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
							</svg>
						</div>
						{{ form_widget(form.company, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': 'Nom de votre entreprise'
                            }
                        }) }}
					</div>
					{{ form_errors(form.company) }}
				</div>


				<div class="space-y-2">
					<label for="{{ form.email.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Email
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
							</svg>
						</div>
						{{ form_widget(form.email, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': 'votre-email@exemple.com'
                            }
                        }) }}
					</div>
					{{ form_errors(form.email) }}
				</div>
                

                <div class="space-y-2">
					<label for="{{ form.roles.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Rôles
					</label>
					<div class="relative">
						
						{{ form_widget(form.roles, {
                            
                        }) }}
					</div>
					{{ form_errors(form.roles) }}
				</div>
                 <div class="space-y-2">
					<label for="{{ form.isVerified.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						est vérifiée
					</label>
					<div class="relative">
						
						{{ form_widget(form.isVerified, {
                            
                        }) }}
					</div>
					{{ form_errors(form.isVerified) }}
				</div>
                <div class="hidden space-y-2">
					<label for="{{ form.plainPassword.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Mot de passe
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
							</svg>
						</div>
						{{ form_widget(form.plainPassword, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': '••••••••'
                            }
                        }) }}
					</div>
					{{ form_errors(form.plainPassword) }}
				</div>

				<div>
					<button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-baluBlue hover:bg-baluBlue-light focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue">
						Ajouter un User
					</button>
				</div>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
