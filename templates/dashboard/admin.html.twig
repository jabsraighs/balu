{% extends 'base.html.twig' %}

{% block title %}Administration - Tableau de bord{% endblock %}

{% block page_content %}
    <div class="container mx-auto px-4 py-8">
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Tableau de bord Administration</h1>
            <p class="text-gray-500 dark:text-gray-400">Bienvenue, {{ app.user.fullname }}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Chiffre d'affaires global</h3>
                    <span class="p-2 bg-blue-100 dark:bg-blue-900/30 text-baluBlue rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="2"/>
                            <path d="M8 13.5v-3a1.5 1.5 0 0 1 3 0v3"/>
                            <path d="M11 13.5v-3a1.5 1.5 0 0 1 3 0v3"/>
                            <path d="M14 13.5v-3a1.5 1.5 0 0 1 3 0v3"/>
                        </svg>
                    </span>
                </div>
                <div class="text-2xl font-bold">{{ invoiceStats is defined and invoiceStats.totalAmount is defined ? invoiceStats.totalAmount|number_format(2, ',', ' ') : '0,00' }} €</div>
                <div class="text-sm text-green-500 mt-2 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
                        <polyline points="16 7 22 7 22 13"></polyline>
                    </svg>
                    <span>+{{ invoiceStats is defined and invoiceStats.percentIncrease is defined ? invoiceStats.percentIncrease|number_format(1) : '0' }}% ce mois</span>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Utilisateurs</h3>
                    <span class="p-2 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </span>
                </div>
                <div class="text-2xl font-bold">{{ userStats is defined and userStats.totalCount is defined ? userStats.totalCount : '0' }}</div>
                <div class="text-sm text-purple-500 mt-2">{{ userStats is defined and userStats.newCount is defined ? userStats.newCount : '0' }} nouveaux ce mois</div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Entreprises</h3>
                    <span class="p-2 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                    </span>
                </div>
                <div class="text-2xl font-bold">{{ companyStats is defined and companyStats.totalCount is defined ? companyStats.totalCount : '0' }}</div>
                <div class="text-sm text-green-500 mt-2">{{ companyStats is defined and companyStats.activeCount is defined ? companyStats.activeCount : '0' }} actives</div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Invitations</h3>
                    <span class="p-2 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400 rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                        </svg>
                    </span>
                </div>
                <div class="text-2xl font-bold">{{ invitationStats is defined and invitationStats.pendingCount is defined ? invitationStats.pendingCount : '0' }}</div>
                <div class="text-sm text-yellow-500 mt-2">{{ invitationStats is defined and invitationStats.usedCount is defined ? invitationStats.usedCount : '0' }} utilisées</div>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-6 mb-8">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Évolution des inscriptions</h2>

            <div class="h-72">
                <canvas id="registrationsChart"></canvas>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Derniers utilisateurs</h2>
                    {# <a href="{{ path('back_admin_user_index') }}" class="text-sm text-baluBlue hover:text-baluBlue-light transition-colors">
                        Voir tous les utilisateurs
                    </a> #}
                </div>

                <div class="space-y-4">
                    {% if recentUsers is defined and recentUsers|length > 0 %}
                        {% for user in recentUsers %}
                            <div class="flex items-center justify-between p-4 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                                <div class="flex items-center space-x-4">
                                    <div class="flex-shrink-0 h-10 w-10 rounded-full bg-baluBlue text-white flex items-center justify-center font-medium">
                                        {{ user.email|first|upper }}
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-900 dark:text-white">{{ user.fullname ?? user.email }}</p>
                                        <p class="text-sm text-gray-500 dark:text-gray-400">{{ user.createdAt|date('d/m/Y') }}</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                                        {% if 'ROLE_ADMIN' in user.roles %}
                                            bg-red-100 text-red-800 dark:bg-red-800/30 dark:text-red-500
                                        {% elseif 'ROLE_ACCOUNTANT' in user.roles %}
                                            bg-blue-100 text-blue-800 dark:bg-blue-800/30 dark:text-blue-500
                                        {% else %}
                                            bg-green-100 text-green-800 dark:bg-green-800/30 dark:text-green-500
                                        {% endif %}">
                                        {% if 'ROLE_ADMIN' in user.roles %}
                                            Admin
                                        {% elseif 'ROLE_ACCOUNTANT' in user.roles %}
                                            Comptable
                                        {% else %}
                                            Entreprise
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="text-center text-gray-500 dark:text-gray-400 py-4">
                            Aucun utilisateur récent
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Dernières entreprises</h2>
                    <a href="#" class="text-sm text-baluBlue hover:text-baluBlue-light transition-colors">
                        Voir toutes les entreprises
                    </a>
                </div>

                <div class="space-y-4">
                    {% if recentCompanies is defined and recentCompanies|length > 0 %}
                        {% for company in recentCompanies %}
                            <div class="flex items-center justify-between p-4 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                                <div class="flex items-center space-x-4">
                                    <div class="flex-shrink-0 h-10 w-10 rounded-full bg-green-500 text-white flex items-center justify-center font-medium">
                                        {{ company.name|first|upper }}
                                    </div>
                                    <div>
                                        <p class="font-medium text-gray-900 dark:text-white">{{ company.name }}</p>
                                        <p class="text-sm text-gray-500 dark:text-gray-400">{{ company.siret }}</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="text-sm text-gray-500 dark:text-gray-400">{{ company.userCount ?? '0' }} utilisateurs</p>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="text-center text-gray-500 dark:text-gray-400 py-4">
                            Aucune entreprise récente
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-8 mt-8">
            <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Statistiques Globales</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="bg-blue-50 dark:bg-blue-900/20 rounded-lg p-4">
                        <div class="text-sm font-medium text-blue-600 dark:text-blue-400 mb-1">Factures créées (total)</div>
                        <div class="text-2xl font-bold text-gray-900 dark:text-white">{{ globalStats is defined and globalStats.invoiceCount is defined ? globalStats.invoiceCount : '0' }}</div>
                    </div>
                    <div class="bg-indigo-50 dark:bg-indigo-900/20 rounded-lg p-4">
                        <div class="text-sm font-medium text-indigo-600 dark:text-indigo-400 mb-1">Devis créés (total)</div>
                        <div class="text-2xl font-bold text-gray-900 dark:text-white">{{ globalStats is defined and globalStats.quoteCount is defined ? globalStats.quoteCount : '0' }}</div>
                    </div>
                    <div class="bg-purple-50 dark:bg-purple-900/20 rounded-lg p-4">
                        <div class="text-sm font-medium text-purple-600 dark:text-purple-400 mb-1">Clients enregistrés (total)</div>
                        <div class="text-2xl font-bold text-gray-900 dark:text-white">{{ globalStats is defined and globalStats.clientCount is defined ? globalStats.clientCount : '0' }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('turbo:load', function() {
            // Données fictives pour le graphique des inscriptions
            // Ces données devraient venir du contrôleur dans une implémentation complète
            const registrationsData = {{ registrationsData is defined ? registrationsData|json_encode|raw : '{}' }};
            
            // Valeurs par défaut si les données ne sont pas disponibles
            const labels = registrationsData.labels ?? ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin'];
            const values = registrationsData.values ?? [5, 8, 12, 9, 15, 10];

            const ctx = document.getElementById('registrationsChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Nouveaux utilisateurs',
                        data: values,
                        backgroundColor: 'rgba(79, 70, 229, 0.1)',
                        borderColor: 'rgba(79, 70, 229, 1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(160, 174, 192, 0.1)'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        });
    </script>
{% endblock %}