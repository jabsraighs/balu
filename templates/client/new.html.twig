{% extends 'base.html.twig' %}

{% block title %}Nouveau Client{% endblock %}

{% block page_content %}
<div class="container mx-auto px-4 py-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">{{ is_edit_mode|default(false) ? 'Modifier Client' : 'Nouveau Client' }}</h1>
    </div>
    
    <div class="mb-6">
        <a href="{{ path('app_client_index') }}" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 19-7-7 7-7"></path>
                <path d="M19 12H5"></path>
            </svg>
            Retour
        </a>
    </div>
    
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden">
        <div class="p-6">
            {{ form_start(form, {
                'attr': {
                    'class': 'space-y-6',
                    'novalidate': 'novalidate'
                }
            }) }}
                
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.name, 'Nom*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.name, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white',
                            'placeholder': 'Nom du client'
                        }
                    }) }}
                    {{ form_errors(form.name, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                
                <div>
                    {{ form_label(form.email, 'Email*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.email, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white',
                            'placeholder': 'email@exemple.com'
                        }
                    }) }}
                    {{ form_errors(form.email, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                
                <div>
                    {{ form_label(form.phone, 'Téléphone', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.phone, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white',
                            'placeholder': '01 23 45 67 89'
                        }
                    }) }}
                    {{ form_errors(form.phone, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                
                <div>
                    {{ form_label(form.address, 'Adresse', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.address, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white',
                            'placeholder': '123 Rue, Ville, Code Postal'
                        }
                    }) }}
                    {{ form_errors(form.address, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                
                {% if form.status is defined %}
                <div>
                    {{ form_label(form.status, 'Statut*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.status, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white'
                        }
                    }) }}
                    {{ form_errors(form.status, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                {% endif %}
            </div>
            
            {% if form.notes is defined %}
            <div>
                {{ form_label(form.notes, 'Notes', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                {{ form_widget(form.notes, {
                    'attr': {
                        'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white min-h-[100px]',
                        'placeholder': 'Ajoutez des notes supplémentaires sur le client ici...'
                    }
                }) }}
                {{ form_errors(form.notes, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
            </div>
            {% endif %}
            
            <div class="flex justify-end space-x-2 mt-6">
                <a 
                    href="{{ path('app_client_index') }}" 
                    class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700"
                >
                    Annuler
                </a>
                <button 
                    type="submit" 
                    class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-baluBlue hover:bg-baluBlue-light rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue"
                >
                    {{ is_edit_mode|default(false) ? 'Mettre à jour' : 'Créer' }}
                </button>
            </div>
            
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Form validation
        const form = document.querySelector('form');
        form.addEventListener('submit', function(event) {
            const errorElements = document.querySelectorAll('.js-form-error');
            errorElements.forEach(element => element.remove());

            let hasErrors = false;
            
            // Name validation
            const nameInput = document.getElementById('client_name');
            if (nameInput && nameInput.value.length < 2) {
                const errorElement = document.createElement('p');
                errorElement.classList.add('text-red-500', 'text-sm', 'mt-1', 'js-form-error');
                errorElement.textContent = 'Le nom doit contenir au moins 2 caractères.';
                nameInput.parentNode.appendChild(errorElement);
                hasErrors = true;
            }
            
            // Email validation
            const emailInput = document.getElementById('client_email');
            if (emailInput) {
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(emailInput.value)) {
                    const errorElement = document.createElement('p');
                    errorElement.classList.add('text-red-500', 'text-sm', 'mt-1', 'js-form-error');
                    errorElement.textContent = 'Veuillez entrer une adresse email valide.';
                    emailInput.parentNode.appendChild(errorElement);
                    hasErrors = true;
                }
            }
            
            if (hasErrors) {
                event.preventDefault();
            }
        });
    });
</script>
{% endblock %}