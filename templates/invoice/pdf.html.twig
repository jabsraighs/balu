<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Facture #{{ invoice.invoiceNumber }}</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; color: #333; }
        .header { margin-bottom: 30px; }
        .company-info { float: left; width: 50%; }
        .invoice-info { float: right; width: 40%; text-align: right; }
        .client-info { margin-top: 50px; margin-bottom: 30px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { background-color: #f5f5f5; text-align: left; padding: 8px; border-bottom: 1px solid #ddd; }
        td { padding: 8px; border-bottom: 1px solid #ddd; }
        .total { text-align: right; margin-top: 20px; font-weight: bold; }
        .footer { margin-top: 50px; font-size: 12px; color: #666; border-top: 1px solid #eee; padding-top: 10px; }
        .clearfix:after { content: ""; display: table; clear: both; }
        h1 { color: #4F46E5; }
        h2 { color: #4F46E5; }
        .payment-info { margin-top: 30px; padding: 15px; background-color: #f9f9f9; border-radius: 5px; }
        .status { padding: 5px 10px; border-radius: 10px; font-size: 12px; font-weight: bold; display: inline-block; }
        .status-paid { background-color: #d1fae5; color: #065f46; }
        .status-pending { background-color: #fef3c7; color: #92400e; }
        .status-overdue { background-color: #fee2e2; color: #b91c1c; }
    </style>
</head>

<body>
    <div class="header clearfix">
        <div class="company-info">
            <h1>{{ invoice.company.name }}</h1>
            {% if invoice.company.address %}
            <p>{{ invoice.company.address|nl2br }}</p>
            {% endif %}
            {% if invoice.company.siret %}
            <p>SIRET : {{ invoice.company.siret }}</p>
            {% endif %}
        </div>
        <div class="invoice-info">
            <h2>Facture #{{ invoice.invoiceNumber }}</h2>
            <p>Date d'émission : {{ invoice.createdAt|date('d/m/Y') }}</p>
            <p>Échéance : {{ invoice.dateDue|date('d/m/Y') }}</p>
            
            <div>
                Statut : 
                <span class="status {% if invoice.status == 'paid' %}status-paid{% elseif invoice.status == 'pending' %}status-pending{% else %}status-overdue{% endif %}">
                    {% if invoice.status == 'paid' %}Payée{% elseif invoice.status == 'pending' %}En attente{% else %}En retard{% endif %}
                </span>
            </div>
            
            {% if invoice.datePaid %}
            <p>Date de paiement : {{ invoice.datePaid|date('d/m/Y') }}</p>
            {% endif %}
        </div>
    </div>
    
    <div class="client-info">
        <h3>Client</h3>
        <p><strong>{{ invoice.client.name }}</strong></p>
        {% if invoice.client.address %}
        <p>{{ invoice.client.address|nl2br }}</p>
        {% endif %}
        {% if invoice.client.email %}
        <p>Email : {{ invoice.client.email }}</p>
        {% endif %}
        {% if invoice.client.phone %}
        <p>Téléphone : {{ invoice.client.phone }}</p>
        {% endif %}
    </div>
    
    <table>
        <thead>
            <tr>
                <th width="40%">Description</th>
                <th width="15%">Quantité</th>
                <th width="15%">Prix unitaire</th>
                <th width="15%">Remise</th>
                <th width="15%">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for line in invoice.invoiceLines %}
            <tr>
                <td>
                    <strong>{{ line.productName }}</strong>
                    {% if line.description %}
                    <br>{{ line.description }}
                    {% endif %}
                </td>
                <td>{{ line.quantity }}</td>
                <td>{{ line.unitPrice|number_format(2, ',', ' ') }} €</td>
                <td>{{ line.discount }}%</td>
                <td>{{ (line.quantity * line.unitPrice * (1 - line.discount / 100))|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    
    <div class="total">
        <p>Total HT : {{ (invoice.totalAmount / 1.2)|number_format(2, ',', ' ') }} €</p>
        <p>TVA (20%) : {{ (invoice.totalAmount - (invoice.totalAmount / 1.2))|number_format(2, ',', ' ') }} €</p>
        <p><strong>Total TTC : {{ invoice.totalAmount|number_format(2, ',', ' ') }} €</strong></p>
    </div>
    
    {% if invoice.payments|length > 0 %}
    <div class="payment-info">
        <h3>Paiements reçus</h3>
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Méthode</th>
                    <th>Montant</th>
                </tr>
            </thead>
            <tbody>
                {% set totalPaid = 0 %}
                {% for payment in invoice.payments %}
                <tr>
                    <td>{{ payment.datePaid|date('d/m/Y') }}</td>
                    <td>
                        {% if payment.method == 'card' %}
                            Carte bancaire
                        {% elseif payment.method == 'bank_transfer' %}
                            Virement bancaire
                        {% elseif payment.method == 'cash' %}
                            Espèces
                        {% elseif payment.method == 'check' %}
                            Chèque
                        {% elseif payment.method == 'paypal' %}
                            PayPal
                        {% else %}
                            {{ payment.method|capitalize }}
                        {% endif %}
                    </td>
                    <td>{{ payment.amount|number_format(2, ',', ' ') }} €</td>
                </tr>
                {% set totalPaid = totalPaid + payment.amount %}
                {% endfor %}
                <tr>
                    <td colspan="2"><strong>Total payé</strong></td>
                    <td><strong>{{ totalPaid|number_format(2, ',', ' ') }} €</strong></td>
                </tr>
                {% if totalPaid < invoice.totalAmount %}
                <tr>
                    <td colspan="2"><strong>Reste à payer</strong></td>
                    <td><strong>{{ (invoice.totalAmount - totalPaid)|number_format(2, ',', ' ') }} €</strong></td>
                </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
    {% endif %}
    
    <div class="footer">
        <p>Conditions de paiement : paiement à réception de facture.</p>
        <p>Facture générée le {{ "now"|date('d/m/Y') }}.</p>
    </div>
</body>
</html>