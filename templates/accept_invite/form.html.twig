{% extends 'base.html.twig' %}

{% block title %}Accepter l'invitation{% endblock %}

{% block page_content %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-md mx-auto bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden">
        <div class="p-6">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Créer votre compte</h1>
            
            <div class="mb-6">
                <p class="text-gray-600 dark:text-gray-400">Veuillez compléter les informations suivantes pour finaliser la création de votre compte.</p>
            </div>
            
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                
                <div class="space-y-2">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        {{ form_widget(form.email, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400'
                            }
                        }) }}
                    </div>
                    {{ form_errors(form.email, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                
                <div class="space-y-2">
                    {{ form_label(form.fullname, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                        </div>
                        {{ form_widget(form.fullname, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-700 text-gray-900 dark:text-white',
                                'placeholder': 'Votre nom complet'
                            }
                        }) }}
                    </div>
                    {{ form_errors(form.fullname, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                
                <div class="space-y-2">
                    {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </div>
                        {{ form_widget(form.plainPassword, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-700 text-gray-900 dark:text-white',
                                'placeholder': '••••••••'
                            }
                        }) }}
                    </div>
                    {% if form.plainPassword.vars.help %}
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">{{ form.plainPassword.vars.help }}</p>
                    {% endif %}
                    {{ form_errors(form.plainPassword, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
                
                <div class="flex justify-end space-x-2 pt-4">
                    <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-baluBlue hover:bg-baluBlue-light focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue">
                        Créer mon compte
                    </button>
                </div>
                
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}