{% extends 'base.html.twig' %}

{% block title %}Invoice{% endblock %}

{% block body %}
    <h1>Invoice</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>CreatedAt</th>
                <td>{{ invoice.createdAt ? invoice.createdAt|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>dateDue</th>
                <td>{{ invoice.dateDue? invoice.dateDue|date('Y-m-d') : '' }}</td>
            </tr>
            
            <tr>
                <th> TotalAmount </th>
                <td>{{ invoice.totalAmount }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_dashboard_invoice_index') }}">back to list</a>

    <a href="{{ path('app_invoice_edit', {'id': invoice.id}) }}">edit</a>

    {{ include('invoice/_delete_form.html.twig') }}
{% endblock %}
