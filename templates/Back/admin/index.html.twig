{# templates/Back/admin/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Administration{% endblock %}

{% block page_content %}
<div class="container mx-auto px-4 py-6 sm:py-8">
    <div class="mb-4 sm:mb-6">
        <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Tableau de bord</h1>
        <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400">Bienvenue, {{ user.fullname }}</p>
    </div>

    {# Cartes statistiques avec amélioration de la responsivité #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mb-6 sm:mb-8">
        {# Carte Chiffre d'affaires #}
        <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-4 sm:p-6">
            <div class="flex items-center justify-between mb-3 sm:mb-4">
                <h3 class="text-xs sm:text-sm font-medium text-gray-500 dark:text-gray-400">Chiffre d'affaires</h3>
                <span class="p-1.5 sm:p-2 bg-blue-100 dark:bg-blue-900/30 text-baluBlue rounded-full">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="3" rx="2" />
                        <path d="M8 13.5v-3a1.5 1.5 0 0 1 3 0v3" />
                        <path d="M11 13.5v-3a1.5 1.5 0 0 1 3 0v3" />
                        <path d="M14 13.5v-3a1.5 1.5 0 0 1 3 0v3" />
                    </svg>
                </span>
            </div>
            <div class="text-xl sm:text-2xl font-bold truncate">{{ invoiceStats.totalAmount|number_format(2, ',', ' ') }} €</div>
            <div class="text-xs sm:text-sm text-green-500 mt-2 flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline>
                </svg>
                <span>+{{ invoiceStats.percentIncrease|number_format(1) }}% ce mois</span>
            </div>
        </div>

        {# Carte Factures en attente #}
        <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-4 sm:p-6">
            <div class="flex items-center justify-between mb-3 sm:mb-4">
                <h3 class="text-xs sm:text-sm font-medium text-gray-500 dark:text-gray-400">Factures en attente</h3>
                <span class="p-1.5 sm:p-2 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400 rounded-full">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                        <polyline points="14 2 14 8 20 8" />
                        <path d="M16 13H8" />
                        <path d="M16 17H8" />
                        <path d="M10 9H8" />
                    </svg>
                </span>
            </div>
            <div class="text-xl sm:text-2xl font-bold">{{ invoiceStats.pendingCount }}</div>
            <div class="text-xs sm:text-sm text-yellow-500 mt-2 truncate">{{ invoiceStats.pendingAmount|number_format(2, ',', ' ') }} € en attente</div>
        </div>

        {# Carte Devis #}
        <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-4 sm:p-6">
            <div class="flex items-center justify-between mb-3 sm:mb-4">
                <h3 class="text-xs sm:text-sm font-medium text-gray-500 dark:text-gray-400">Devis</h3>
                <span class="p-1.5 sm:p-2 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 rounded-full">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                </span>
            </div>
            <div class="text-xl sm:text-2xl font-bold">{{ quoteStats.totalCount }}</div>
            <div class="text-xs sm:text-sm text-purple-500 mt-2">Taux de conversion: {{ quoteStats.conversionRate|number_format(1) }}%</div>
        </div>

        {# Carte Clients #}
        <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-4 sm:p-6">
            <div class="flex items-center justify-between mb-3 sm:mb-4">
                <h3 class="text-xs sm:text-sm font-medium text-gray-500 dark:text-gray-400">Clients</h3>
                <span class="p-1.5 sm:p-2 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </span>
            </div>
            <div class="text-xl sm:text-2xl font-bold">{{ clientStats.totalCount }}</div>
            <div class="text-xs sm:text-sm text-green-500 mt-2">{{ clientStats.newCount }} nouveaux ce mois</div>
        </div>
    </div>

    {# Graphique évolution chiffre d'affaires - ajout de classes pour responsivité #}
    {#
    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-4 sm:p-6 mb-6 sm:mb-8">
        <h2 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white mb-4 sm:mb-6">Évolution du chiffre d'affaires</h2>
        <div class="h-56 sm:h-72">
            <div class="flex items-end h-48 sm:h-64 justify-between border-b border-gray-200 dark:border-gray-700">
                {% for month in invoiceStats.monthlyRevenue %}
                    <div class="flex flex-col items-center w-full">
                        <div class="bg-baluBlue rounded-t w-6 sm:w-12 mx-auto transition-all duration-300 hover:bg-baluBlue-light"
                             style="height: {{ (month.amount / invoiceStats.maxMonthlyRevenue * 100)|number_format(0) }}%">
                        </div>
                        <span class="text-xs mt-1 sm:mt-2 text-gray-500 dark:text-gray-400 truncate w-full text-center">{{ month.label }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
    #}

    {# Sections Factures et Devis récents #}
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
        <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
            <div class="p-4 sm:p-6 border-b border-gray-200 dark:border-gray-700">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <h2 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Factures récentes</h2>
                    <a href="{{ path('app_dashboard_invoice_index') }}" class="inline-flex items-center justify-center px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-medium text-white bg-baluBlue rounded-md hover:bg-baluBlue-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue-light whitespace-nowrap">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                            <polyline points="14 2 14 8 20 8" />
                        </svg>
                        Toutes les factures
                    </a>
                </div>
            </div>
            {% include 'Back/admin/user/invoice/index.html.twig' %}
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
            <div class="p-4 sm:p-6 border-b border-gray-200 dark:border-gray-700">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <h2 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-white">Devis récents</h2>
                    <a href="{{ path('app_dashboard_quote_index') }}" class="inline-flex items-center justify-center px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-medium text-white bg-baluBlue rounded-md hover:bg-baluBlue-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue-light whitespace-nowrap">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                            <line x1="12" y1="22.08" x2="12" y2="12" />
                        </svg>
                        Tous les devis
                    </a>
                </div>
            </div>
            {% include 'Back/admin/user/quote/index.html.twig' %}
        </div>
    </div>
</div>
{% endblock %}