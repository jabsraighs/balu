{% extends 'base.html.twig' %}

{% block title %}Créer un compte
{% endblock %}

{% block body %}
	<div class="min-h-screen flex bg-gray-50 dark:bg-gray-900">
		<div class="hidden lg:flex lg:w-1/2 bg-baluBlue-dark relative">
			<div class="absolute inset-0 bg-gradient-to-b from-baluBlue-dark/80 to-baluBlue-dark">
				<img src="{{ asset('images/background.jpg') }}" alt="Background" class="object-cover w-full h-full mix-blend-overlay opacity-30"/>
			</div>
			<div class="relative z-10 flex flex-col justify-center px-12 text-white">
				<h1 class="text-4xl font-bold mb-6">
					ACCÉDEZ À UN MONDE DE POSSIBILITÉS FREELANCE EN TOUTE SIMPLICITÉ.
				</h1>
				<p class="text-lg opacity-90">
					Créez votre compte pour gérer vos devis avec facilité et gagnez du temps pour ce qui compte vraiment – votre travail créatif. Simplifiez votre quotidien freelance dès maintenant!
				</p>
			</div>
		</div>

		{# Right side - Registration form #}
		<div class="w-full lg:w-1/2 flex items-center justify-center p-8">
			<div class="w-full max-w-md">
				<div class="text-center mb-8">
					<img src="{{ asset('images/Logo.png') }}" alt="BaluDevis Logo" class="mx-auto h-16 mb-6"/>
					<h2 class="text-3xl font-bold text-baluBlue mb-2">Créer un compte</h2>
					<p class="text-gray-600 dark:text-gray-400">
						Remplissez vos informations pour commencer avec BaluDevis
					</p>
				</div>

				{% for flash_error in app.flashes('verify_email_error') %}
					<div class="mb-4 p-4 text-sm text-red-800 bg-red-100 rounded-lg" role="alert">{{ flash_error }}</div>
				{% endfor %}

				{{ form_errors(registrationForm) }}

				{{ form_start(registrationForm, {'attr': {'class': 'space-y-6'}}) }}
				<div class="space-y-2">
					<label for="{{ registrationForm.fullname.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Nom complet
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
						</div>
						{{ form_widget(registrationForm.fullname, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': 'John Doe'
                            }
                        }) }}
					</div>
					{{ form_errors(registrationForm.fullname) }}
				</div>

				<div class="space-y-2">
					<label for="{{ registrationForm.companyName.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Nom de l'entreprise
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
							</svg>
						</div>
						{{ form_widget(registrationForm.companyName, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': 'Nom de votre entreprise'
                            }
                        }) }}
					</div>
					{{ form_errors(registrationForm.companyName) }}
				</div>

				<div class="space-y-2">
					<label for="{{ registrationForm.siret.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Numéro de SIRET
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
							</svg>
						</div>
						{{ form_widget(registrationForm.siret, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': '12345678901234',
                                'pattern': '[0-9]{14}',
                                'maxlength': '14'
                            }
                        }) }}
					</div>
					{{ form_errors(registrationForm.siret) }}
				</div>

				<div class="space-y-2">
					<label for="{{ registrationForm.address.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Adresse
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
							</svg>
						</div>
						{{ form_widget(registrationForm.address, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': 'Votre adresse complète',
                                'rows': '3'
                            }
                        }) }}
					</div>
					{{ form_errors(registrationForm.address) }}
				</div>

				<div class="space-y-2">
					<label for="{{ registrationForm.email.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Email
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
							</svg>
						</div>
						{{ form_widget(registrationForm.email, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': 'votre-email@exemple.com'
                            }
                        }) }}
					</div>
					{{ form_errors(registrationForm.email) }}
				</div>

				<div class="space-y-2">
					<label for="{{ registrationForm.plainPassword.vars.id }}" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
						Mot de passe
					</label>
					<div class="relative">
						<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
							</svg>
						</div>
						{{ form_widget(registrationForm.plainPassword, {
                            'attr': {
                                'class': 'block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-baluBlue focus:border-baluBlue dark:bg-gray-800 dark:border-gray-700 dark:text-white',
                                'placeholder': '••••••••'
                            }
                        }) }}
					</div>
					{{ form_errors(registrationForm.plainPassword) }}
				</div>

				<div class="flex items-center">
					{{ form_widget(registrationForm.agreeTerms, {
                        'attr': {
                            'class': 'h-4 w-4 text-baluBlue focus:ring-baluBlue border-gray-300 rounded dark:border-gray-700 dark:bg-gray-800'
                        }
                    }) }}
					<label for="{{ registrationForm.agreeTerms.vars.id }}" class="ml-2 block text-sm text-gray-700 dark:text-gray-300">
						J'accepte les
						<a href="#" class="font-medium text-baluBlue hover:text-baluBlue-light">
							conditions d'utilisation
						</a>
						et la
						<a href="#" class="font-medium text-baluBlue hover:text-baluBlue-light">
							politique de confidentialité
						</a>
					</label>
				</div>
				{{ form_errors(registrationForm.agreeTerms) }}

				<div>
					<button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-baluBlue hover:bg-baluBlue-light focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue">
						Créer un compte
					</button>
				</div>
				{{ form_end(registrationForm) }}

				<div class="mt-6 text-center">
					<p class="text-sm text-gray-600 dark:text-gray-400">
						Vous avez déjà un compte?
						<a href="{{ path('app_login') }}" class="font-medium text-baluBlue hover:text-baluBlue-light">
							Se connecter
						</a>
					</p>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
