{% set mobileMenuOpen = false %}
{% set sidebarCollapsed = false %}
{% set userDisplay = {
    name: app.user ? app.user.fullname : 'Utilisateur',
    email: app.user ? app.user.email : ''
} %}

<body
	class="min-h-screen bg-gray-50 dark:bg-gray-950">
	{% include '_components/sidebar.html.twig' with {
    mobileOpen: mobileMenuOpen,
    isCollapsed: sidebarCollapsed
  } %}

	<div
		class="transition-all duration-300 {{ sidebarCollapsed ? 'lg:pl-20' : 'lg:pl-64' }}">
		{% include '_components/header.html.twig' with {
      user: userDisplay
    } only %}

		<main class="p-4 lg:p-6">
			{% if pageTitle is defined and pageTitle or welcomeMessage is defined and welcomeMessage %}
				<div class="mb-6">
					{% if pageTitle is defined and pageTitle %}
						<h1 class="text-2xl font-bold text-gray-900 dark:text-white">{{ pageTitle }}</h1>
					{% endif %}
					{% if welcomeMessage is defined and welcomeMessage %}
						<p class="text-gray-500 dark:text-gray-400">{{ welcomeMessage }}</p>
					{% endif %}
				</div>
			{% endif %}

			{# Messages flash #}
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="mb-4 p-4 rounded-lg {% if label == 'success' %}bg-green-100 text-green-800{% elseif label == 'error' %}bg-red-100 text-red-800{% else %}bg-blue-100 text-blue-800{% endif %}">
						{{ message }}
					</div>
				{% endfor %}
			{% endfor %}

			{{ content|raw }}
		</main>
	</div>

	<script>
		window.appConfig = {
mobileMenuOpen: {{ mobileMenuOpen ? 'true' : 'false' }},
sidebarCollapsed: {{ sidebarCollapsed ? 'true' : 'false' }},
logoutPath: "{{ path('app_logout') }}"
};
	</script>

	{% block javascripts %}
		{{ encore_entry_script_tags('layout') }}
	{% endblock %}
</body></html>
