<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rapport Financier</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; color: #333; }
        .header { margin-bottom: 30px; text-align: center; }
        .company-info { margin-bottom: 20px; }
        .section { margin-bottom: 30px; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 20px; }
        th { background-color: #f5f5f5; text-align: left; padding: 8px; border-bottom: 1px solid #ddd; }
        td { padding: 8px; border-bottom: 1px solid #ddd; }
        .total { text-align: right; margin-top: 10px; font-weight: bold; }
        .footer { margin-top: 50px; font-size: 12px; color: #666; text-align: center; }
        h1 { color: #4F46E5; }
        h2 { color: #4F46E5; font-size: 18px; margin-top: 30px; }
        h3 { font-size: 16px; margin-top: 20px; }
        .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
        .summary-box { border: 1px solid #e5e7eb; padding: 15px; border-radius: 5px; }
        .summary-label { color: #6b7280; font-size: 14px; }
        .summary-value { font-size: 18px; font-weight: bold; color: #111827; }
        .chart-placeholder { height: 200px; background: #f9fafb; border: 1px dashed #d1d5db; margin: 15px 0; text-align: center; line-height: 200px; color: #6b7280; }
        .status-paid { color: #10b981; }
        .status-pending { color: #f59e0b; }
        .status-overdue { color: #ef4444; }
        .page-break { page-break-after: always; }
    </style>
</head>

<body>
    <div class="header">
        <h1>Rapport Financier</h1>
        <p>Aperçu de la situation financière - Généré le {{ "now"|date('d/m/Y') }}</p>
    </div>
    
    <div class="summary-grid">
        <div class="summary-box">
            <div class="summary-label">Total Payé</div>
            <div class="summary-value">{{ reportData.totalPaid|number_format(2, ',', ' ') }} €</div>
        </div>
        <div class="summary-box">
            <div class="summary-label">Total Impayé</div>
            <div class="summary-value">{{ reportData.totalUnpaid|number_format(2, ',', ' ') }} €</div>
        </div>
        <div class="summary-box">
            <div class="summary-label">Moyenne par Facture</div>
            <div class="summary-value">{{ reportData.averageInvoice|number_format(2, ',', ' ') }} €</div>
        </div>
        <div class="summary-box">
            <div class="summary-label">Taux de Conversion</div>
            <div class="summary-value">{{ conversionRate|number_format(1, ',', ' ') }}%</div>
        </div>
    </div>

    <div class="page-break"></div>

    <div class="section">
        <h2>Répartition des factures</h2>
        <div class="chart-placeholder">
            Graphique de répartition des factures - Consultez la version web pour les visualisations.
        </div>
        
        <table>
            <thead>
                <tr>
                    <th>Statut</th>
                    <th>Montant</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Payé</td>
                    <td>{{ reportData.totalPaid|number_format(2, ',', ' ') }} €</td>
                </tr>
                <tr>
                    <td>En attente</td>
                    <td>{{ reportData.totalUnpaid|number_format(2, ',', ' ') }} €</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="section">
        <h2>Dernières factures</h2>
        <table>
            <thead>
                <tr>
                    <th>Client</th>
                    <th>N°</th>
                    <th>Date</th>
                    <th>Montant</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for invoice in reportData.latestInvoices %}
                    <tr>
                        <td>{{ invoice.client.name }}</td>
                        <td>{{ invoice.invoiceNumber }}</td>
                        <td>{{ invoice.createdAt|date('d/m/Y') }}</td>
                        <td>{{ invoice.totalAmount|number_format(2, ',', ' ') }} €</td>
                        <td>
                            {% if invoice.status == 'paid' %}
                                <span class="status-paid">Payée</span>
                            {% elseif invoice.status == 'pending' %}
                                <span class="status-pending">En attente</span>
                            {% elseif invoice.status == 'draft' %}
                                <span>Brouillon</span>
                            {% elseif invoice.status == 'cancelled' %}
                                <span class="status-overdue">Annulée</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" style="text-align: center;">Aucune facture récente</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="page-break"></div>

    <div class="section">
        <h2>Montants par statut</h2>
        <div class="chart-placeholder">
            Graphique des montants par statut - Consultez la version web pour les visualisations.
        </div>
    </div>

    <div class="section">
        <h2>Top 5 Clients</h2>
        <table>
            <thead>
                <tr>
                    <th>Rang</th>
                    <th>Client</th>
                    <th>Montant Total</th>
                </tr>
            </thead>
            <tbody>
                {% if reportData.topClients is iterable %}
                    {% for client in reportData.topClients %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ client.client_name }}</td>
                            <td>{{ client.total|number_format(2, ',', ' ') }} €</td>
                        </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="3" style="text-align: center;">Aucun client trouvé</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>

    <div class="section">
        <h2>Méthodes de paiement</h2>
        <div class="chart-placeholder">
            Graphique des méthodes de paiement - Consultez la version web pour les visualisations.
        </div>
        
        {% if reportData.paymentMethods is iterable %}
            <table>
                <thead>
                    <tr>
                        <th>Méthode</th>
                        <th>Nombre</th>
                        <th>Pourcentage</th>
                    </tr>
                </thead>
                <tbody>
                    {% for method in reportData.paymentMethods %}
                        <tr>
                            <td>
                                {% if method.method == 'card' %}
                                    Carte bancaire
                                {% elseif method.method == 'bank_transfer' %}
                                    Virement bancaire
                                {% elseif method.method == 'cash' %}
                                    Espèces
                                {% elseif method.method == 'check' %}
                                    Chèque
                                {% elseif method.method == 'paypal' %}
                                    PayPal
                                {% else %}
                                    {{ method.method|capitalize }}
                                {% endif %}
                            </td>
                            <td>{{ method.count }}</td>
                            <td>
                                {% set total = reportData.paymentMethods|reduce((sum, m) => sum + m.count, 0) %}
                                {% set percentage = (method.count / total * 100)|round(1) %}
                                {{ percentage }}%
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>Aucune donnée sur les méthodes de paiement disponible</p>
        {% endif %}
    </div>

    <div class="footer">
        <p>© {{ "now"|date("Y") }} - Tous droits réservés</p>
        <p>Rapport généré automatiquement par BaluDevis</p>
    </div>
</body>
</html>