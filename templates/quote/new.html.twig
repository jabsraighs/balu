{% extends 'base.html.twig' %}

{% block title %}Nouveau Devis
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
	<style>
		.autocomplete-container {
			position: relative;
		}
		.autocomplete-items {
			position: absolute;
			border: 1px solid #d4d4d4;
			border-bottom: none;
			border-top: none;
			z-index: 1000;
			top: 100%;
			left: 0;
			right: 0;
			max-height: 200px;
			overflow-y: auto;
			background: white;
		}
		.table-container {
			overflow: visible !important;
		}
		.autocomplete-items div {
			padding: 10px;
			cursor: pointer;
			border-bottom: 1px solid #d4d4d4;
		}
		.autocomplete-items div:hover {
			background-color: #e9e9e9;
		}
		.autocomplete-active {
			background-color: #e9e9e9 !important;
		}
		.dark .autocomplete-items {
			background: #1f2937;
			border-color: #374151;
		}
		.dark .autocomplete-items div {
			border-color: #374151;
		}
		.dark .autocomplete-items div:hover {
			background-color: #374151;
		}
		.dark .autocomplete-active {
			background-color: #374151 !important;
		}
	</style>
{% endblock %}

{% block page_content %}
	<div class="container mx-auto px-4 py-8">
		<div class="mb-6">
			<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Nouveau Devis</h1>
		</div>

		<div class="mb-6">
			<a href="{{ path('app_quote_index') }}" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700">
				<svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m12 19-7-7 7-7"></path>
					<path d="M19 12H5"></path>
				</svg>
				Retour à la liste
			</a>
		</div>

		<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden">
			<div class="p-6">
				{{ form_start(form, {
                'attr': {
                    'class': 'space-y-6',
                    'novalidate': 'novalidate',
                    'id': 'quoteForm',
                    'data-controller': 'quote-form',
                    'data-action': 'submit->quote-form#submitForm',
                    'data-quote-form-products-value': products|e('html_attr'),
                }
            }) }}
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						{{ form_label(form.client, 'Client*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
						{{ form_widget(form.client, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white'
                        }
                    }) }}
						{{ form_errors(form.client, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
					</div>

					<div>
						{{ form_label(form.quoteNumber, 'Numéro de devis*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
						{{ form_widget(form.quoteNumber, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white'
                        }
                    }) }}
						{{ form_errors(form.quoteNumber, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
					</div>

					<div>
						{{ form_label(form.dateCreated, 'Date*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
						{{ form_widget(form.dateCreated, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white datepicker',
                            "type": "date"
                        }
                    }) }}
						{{ form_errors(form.dateCreated, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
					</div>

					<div>
						{{ form_label(form.dateValidUntil, 'Valide jusqu\'au*', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.dateValidUntil, {
                        'attr': {
                            'class': 'mt-1 block w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm focus:ring-baluBlue focus:border-baluBlue bg-white dark:bg-gray-800 text-gray-900 dark:text-white datepicker',
                            "type": "date"
                        }
                    }) }}
                    {{ form_errors(form.dateValidUntil, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Lignes de devis*</label>
                <div class="table-container">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700" id="lineItemsTable">
                        <thead>
                            <tr>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Produit / Description</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Quantité</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Prix unitaire</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Remise %</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Montant</th>
                                <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700" id="lineItemsBody" data-quote-form-target="lineItemsBody">
                            {% for quoteItem in form.quoteLines %}
                                <tr class="line-item" data-controller="line-item" data-action="line-item:calculationComplete->quote-form#updateTotals">
                                    <td class="px-4 py-2">
                                        <div class="autocomplete-container" data-controller="autocomplete" data-autocomplete-products-value="{{ products|json_encode }}">
                                            <input type="text" class="description-input w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md" placeholder="Tapez le nom d'un produit ou une description"
                                                data-autocomplete-target="input"
                                                data-action="input->autocomplete#search keydown->autocomplete#navigateList blur->autocomplete#blur">
                                            {{ form_widget(quoteItem.productName, {
                                                'attr': {
                                                    'class': 'hidden product-name-input',
                                                    'data-autocomplete-target': 'productName',
                                                    'data-line-item-target': 'productName'
                                                }
                                            }) }}
                                            {% if quoteItem.productDescription is defined %}
                                                {{ form_widget(quoteItem.productDescription, {
                                                    'attr': {
                                                        'class': 'hidden product-description-input',
                                                        'data-autocomplete-target': 'productDescription',
                                                        'data-line-item-target': 'productDescription'
                                                    }
                                                }) }}
                                            {% else %}
                                                <input type="hidden" name="quote[quoteLines][{{ loop.index0 }}][productDescription]" value="Description par défaut" class="product-description-input"
																								                                                    data-autocomplete-target="productDescription"
																								                                                    data-line-item-target="productDescription">
					{% endif %}
					{{ form_widget(quoteItem.description, {
                                                'attr': {
                                                    'class': 'hidden',
                                                    'data-autocomplete-target': 'description',
                                                    'data-line-item-target': 'description'
                                                }
                                            }) }}
				</div>
			</td>
			<td class="px-4 py-2">
				{{ form_widget(quoteItem.quantity, {
                                            'attr': {
                                                'class': 'w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md quantity-input',
                                                'data-line-item-target': 'quantity',
                                                'data-action': 'input->line-item#calculate'
                                            }
                                        }) }}
			</td>
			<td class="px-4 py-2">
				{{ form_widget(quoteItem.unitPrice, {
                                            'attr': {
                                                'class': 'w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md unit-price-input',
                                                'data-line-item-target': 'unitPrice',
                                                'data-autocomplete-target': 'unitPrice',
                                                'data-action': 'input->line-item#calculate autocomplete:productSelected->line-item#calculate'
                                            }
                                        }) }}
			</td>
			<td class="px-4 py-2">
				{{ form_widget(quoteItem.discount, {
                                            'attr': {
                                                'class': 'w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md discount-input',
                                                'data-line-item-target': 'discount',
                                                'data-action': 'input->line-item#calculate'
                                            }
                                        }) }}
			</td>
			<td class="px-4 py-2">
				<span class="w-full p-2 bg-gray-100 dark:bg-gray-700 border border-gray-300 dark:border-gray-700 rounded-md amount-input" data-line-item-target="amount">0,00 €</span>
			</td>
			<td class="px-4 py-2 text-right">
				<button type="button" class="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 delete-line-item" data-action="line-item#delete">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M3 6h18"></path>
						<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
						<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2-2v2"></path>
					</svg>
				</button>
			</td>
		</tr>
	{% else %}
		<tr class="line-item" data-controller="line-item" data-action="line-item:calculationComplete->quote-form#updateTotals line-item:lineItemRemoved->quote-form#updateLineItemIndexes line-item:lineItemRemoved->quote-form#updateTotals">
			<td class="px-4 py-2">
				<div class="autocomplete-container" data-controller="autocomplete" data-autocomplete-products-value="{{ products|json_encode }}">
					<input type="text" class="description-input w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md" placeholder="Tapez le nom d'un produit ou une description" data-autocomplete-target="input" data-action="input->autocomplete#search keydown->autocomplete#navigateList blur->autocomplete#blur">
					<input type="hidden" name="quote[quoteLines][0][productName]" class="product-name-input" data-autocomplete-target="productName" data-line-item-target="productName">
					<input type="hidden" name="quote[quoteLines][0][productDescription]" value="Description par défaut" class="product-description-input" data-autocomplete-target="productDescription" data-line-item-target="productDescription">
					<input type="hidden" name="quote[quoteLines][0][description]" value="Produit personnalisé" class="description-hidden-input" data-autocomplete-target="description" data-line-item-target="description">
				</div>
			</td>
			<td class="px-4 py-2">
				<input type="number" name="quote[quoteLines][0][quantity]" value="1" required min="1" class="w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md quantity-input" data-line-item-target="quantity" data-action="input->line-item#calculate">
			</td>
			<td class="px-4 py-2">
				<input type="number" name="quote[quoteLines][0][unitPrice]" value="0" required min="0" step="0.01" class="w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md unit-price-input" data-line-item-target="unitPrice" data-autocomplete-target="unitPrice" data-action="input->line-item#calculate autocomplete:productSelected->line-item#calculate">
			</td>
			<td class="px-4 py-2">
				<input type="number" name="quote[quoteLines][0][discount]" value="0" min="0" max="100" class="w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md discount-input" data-line-item-target="discount" data-action="input->line-item#calculate">
			</td>
			<td class="px-4 py-2">
				<span class="w-full p-2 bg-gray-100 dark:bg-gray-700 border border-gray-300 dark:border-gray-700 rounded-md amount-input" data-line-item-target="amount">0,00 €</span>
			</td>
			<td class="px-4 py-2 text-right">
				<button type="button" class="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 delete-line-item" data-action="line-item#delete">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M3 6h18"></path>
						<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
						<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2-2v2"></path>
					</svg>
				</button>
			</td>
		</tr>
	{% endfor %}
</tbody></table></div><div class="mt-4"><button type="button" id="addLineItem" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700" data-action="quote-form#addLineItem">
<svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
	<path d="M5 12h14"></path>
	<path d="M12 5v14"></path>
</svg>
Ajouter une ligne</button></div><div class="mt-4 flex justify-end"><div class="w-64">
<div class="flex justify-between py-2 border-t border-gray-200 dark:border-gray-700">
	<span class="font-medium">Sous-total:</span>
	<span id="subtotal" data-quote-form-target="subtotal">0,00 €</span>
</div>
<div class="flex justify-between py-2 border-t border-gray-200 dark:border-gray-700">
	<span class="font-medium">Total:</span>
	<span id="total" class="font-bold" data-quote-form-target="total">0,00 €</span>
</div></div></div></div><div class="flex justify-end space-x-2"><a href="{{ path('app_quote_index') }}" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-gray-700 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700">Annuler</a><button type="submit" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-baluBlue hover:bg-baluBlue-light rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue">Créer le devis</button></div><!-- Template pour nouvelles lignes de devis --><template data-quote-form-target="lineItemTemplate"><tr class="line-item" data-controller="line-item" data-action="line-item:calculationComplete->quote-form#updateTotals line-item:lineItemRemoved->quote-form#updateLineItemIndexes line-item:lineItemRemoved->quote-form#updateTotals"><td class="px-4 py-2">
<div class="autocomplete-container" data-controller="autocomplete" data-autocomplete-products-value="{{ products|json_encode }}">
	<input type="text" class="description-input w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md" placeholder="Tapez le nom d'un produit ou une description" data-autocomplete-target="input" data-action="input->autocomplete#search keydown->autocomplete#navigateList blur->autocomplete#blur">
	<input type="hidden" name="quote[quoteLines][__index__][productName]" class="product-name-input" data-autocomplete-target="productName" data-line-item-target="productName">
	<input type="hidden" name="quote[quoteLines][__index__][productDescription]" value="Description par défaut" class="product-description-input" data-autocomplete-target="productDescription" data-line-item-target="productDescription">
	<input type="hidden" name="quote[quoteLines][__index__][description]" value="Produit personnalisé" class="description-hidden-input" data-autocomplete-target="description" data-line-item-target="description">
</div></td><td class="px-4 py-2">
<input type="number" name="quote[quoteLines][__index__][quantity]" value="1" required min="1" class="w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md quantity-input" data-line-item-target="quantity" data-action="input->line-item#calculate"></td><td class="px-4 py-2">
<input type="number" name="quote[quoteLines][__index__][unitPrice]" value="0" required min="0" step="0.01" class="w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md unit-price-input" data-line-item-target="unitPrice" data-autocomplete-target="unitPrice" data-action="input->line-item#calculate autocomplete:productSelected->line-item#calculate"></td><td class="px-4 py-2">
<input type="number" name="quote[quoteLines][__index__][discount]" value="0" min="0" max="100" class="w-full p-2 border border-gray-300 dark:border-gray-700 rounded-md discount-input" data-line-item-target="discount" data-action="input->line-item#calculate"></td><td class="px-4 py-2">
<span class="w-full p-2 inline-block bg-gray-100 dark:bg-gray-700 border border-gray-300 dark:border-gray-700 rounded-md amount-input" data-line-item-target="amount">0,00 €</span></td><td class="px-4 py-2 text-right">
<button type="button" class="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 delete-line-item" data-action="line-item#delete">
	<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M3 6h18"></path>
		<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
		<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2-2v2"></path>
	</svg>
</button></td></tr></template>{{ form_rest(form) }}{{ form_end(form) }}</div></div></div>{% endblock %}{% block javascripts %}{{ parent() }}<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>{% endblock %}
