{% extends 'base.html.twig' %}

{% block title %}Invitations
{% endblock %}

{% block page_content %}
	<div class="container mx-auto px-4 py-8">
		<div class="mb-6">
			<h1 class="text-2xl font-bold text-gray-900 dark:text-white">Invitations</h1>
		</div>

		<div class="flex justify-between items-center mb-6">
			<div>
				<h2 class="text-xl font-semibold text-gray-900 dark:text-white">Toutes les invitations</h2>
				<p class="text-gray-500 dark:text-gray-400">Gérez les invitations à rejoindre votre entreprise</p>
			</div>
			<a href="{{ path('app_invitation_new') }}" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-baluBlue hover:bg-baluBlue-light rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-baluBlue">
				<svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M5 12h14"></path>
					<path d="M12 5v14"></path>
				</svg>
				Nouvelle invitation
			</a>
		</div>

		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="mb-4 p-4 rounded-md alert-dismissible {{ label == 'success' ? 'bg-green-50 dark:bg-green-900/20 text-green-800 dark:text-green-400' : 'bg-red-50 dark:bg-red-900/20 text-red-800 dark:text-red-400' }}">
					<div class="flex items-center">
						{% if label == 'success' %}
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" viewbox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
							</svg>
						{% else %}
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" viewbox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd"/>
							</svg>
						{% endif %}
						{{ message }}
						<button type="button" class="ml-auto btn-close">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewbox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
							</svg>
						</button>
					</div>
				</div>
			{% endfor %}
		{% endfor %}

		<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden">
			<div class="relative w-full overflow-auto">
				<table class="w-full caption-bottom text-sm">
					<thead>
						<tr class="border-b transition-colors hover:bg-muted/50">
							<th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Email</th>
							<th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Rôle</th>
							<th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Date d'envoi</th>
							<th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Invité par</th>
							<th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground w-40">Statut</th>
						</tr>
					</thead>
					<tbody>
						{% for invitation in invitations %}
							<tr class="border-b transition-colors hover:bg-muted/50">
								<td class="p-4 align-middle">{{ invitation.email }}</td>
								<td class="p-4 align-middle">
									{% for role in invitation.roles %}
										{% if role == 'ROLE_ACCOUNTANT' %}
											<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-800/20 dark:text-purple-400">
												Comptable
											</span>
										{% elseif role == 'ROLE_COMPANY' %}
											<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-800/20 dark:text-blue-400">
												Utilisateur entreprise
											</span>
										{% else %}
											{{ role }}
										{% endif %}
									{% endfor %}
								</td>
								<td class="p-4 align-middle">{{ invitation.createdAt|date('d/m/Y H:i') }}</td>
								<td class="p-4 align-middle">{{ invitation.invitedBy ? invitation.invitedBy.fullname : 'Inconnu' }}</td>
								<td class="p-4 align-middle">
                                    {% if invitation.usedAt %}
                                        <span class="inline-flex items-center bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full dark:bg-green-900/30 dark:text-green-300">
                                            <span class="w-2 h-2 me-1.5 bg-green-500 rounded-full"></span>
                                            Acceptée{% if invitation.usedAt %} ({{ invitation.usedAt|date('d/m/Y') }}){% endif %}
                                        </span>
                                    {% elseif invitation.expiresAt < date() %}
                                        <span class="inline-flex items-center bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded-full dark:bg-gray-700 dark:text-gray-300">
                                            <span class="w-2 h-2 me-1.5 bg-gray-500 rounded-full"></span>
                                            Expirée
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded-full dark:bg-yellow-900/30 dark:text-yellow-300">
                                            <span class="w-2 h-2 me-1.5 bg-yellow-500 rounded-full"></span>
                                            En attente
                                        </span>
                                    {% endif %}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="6" class="p-4 align-middle text-center text-gray-500 dark:text-gray-400">Aucune invitation envoyée pour le moment.</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

		<div id="deleteConfirmModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden">
			<div class="bg-white dark:bg-gray-800 rounded-lg max-w-md w-full mx-auto">
				<div class="p-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
					<h5 class="text-lg font-semibold text-gray-900 dark:text-white">Supprimer l'invitation</h5>
					<button type="button" class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300" id="closeModal">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
				<div class="p-4 border-b border-gray-200 dark:border-gray-700">
					<p class="text-gray-700 dark:text-gray-300">Êtes-vous sûr de vouloir supprimer cette invitation ? Cette action ne peut pas être annulée.</p>
				</div>
				<div class="p-4 flex justify-end gap-2">
					<button type="button" id="cancelDelete" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600 dark:hover:bg-gray-600">
						Annuler
					</button>
					<form id="deleteInvitationForm" method="POST" action="">
						<input type="hidden" name="_token" id="csrf_token_placeholder" value="">
						<button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-700 focus:outline-none dark:bg-red-700 dark:hover:bg-red-800">
							Supprimer
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>

	<script>

		const flashMessages = document.querySelectorAll('.alert-dismissible');
flashMessages.forEach(function (flashMessage) {
const closeButton = flashMessage.querySelector('.btn-close');
if (closeButton) {
closeButton.addEventListener('click', function () {
flashMessage.remove();
});
}

setTimeout(function () {
flashMessage.remove();
}, 5000);
});
	</script>
{% endblock %}
